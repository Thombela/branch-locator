# Base URL of the Branch Locator API. Leave empty to call the same origin.
VITE_API_BASE_URL=
# Serve the API from the in-browser mock (Mock Service Worker). Set to "false" when a real backend is available.
VITE_ENABLE_MOCKS=true
# MapLibre style URLs for the light and dark map. Defaults to OpenFreeMap (no API key needed).
# If you change the host, update connect-src in nginx/security-headers.conf too.
VITE_MAP_STYLE_LIGHT=
VITE_MAP_STYLE_DARK=
